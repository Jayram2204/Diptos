# Diptos (diptos.xyz) Environment Configuration
# Set your Privy App ID from https://dashboard.privy.io to enable live Privy Auth & Smart Wallets on Base (8453) and Base Sepolia (84532).
# If left empty, Diptos runs in Institutional Sandbox Mode so all 3 architectural layers and executeSponsoredTx() can be tested locally.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453
